<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree + Form for Segmentation -->
    <record id="view_crm_lead_segmentation_tree" model="ir.ui.view">
        <field name="name">crm.lead.segmentation.tree</field>
        <field name="model">crm.lead.segmentation</field>
        <field name="arch" type="xml">
            <tree string="Lead Segmentation" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_lead_segmentation_form" model="ir.ui.view">
        <field name="name">crm.lead.segmentation.form</field>
        <field name="model">crm.lead.segmentation</field>
        <field name="arch" type="xml">
            <form string="Lead Segmentation">
                <sheet>
                    <!-- <group>
                        <field name="name"/>
                    </group> -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Agriculture"/>
                        </h1>
                    </div>  
                </sheet>
            </form>
        </field>
    </record>

