<?xml version="1.0"?>
<odoo>
    <!--
        crm.tag views
    -->
    <record id="crm_lead_category_view_form" model="ir.ui.view">
        <field name="name">crm.lead.category.view.form</field>
        <field name="model">crm.lead.category</field>
        <field name="arch" type="xml">
            <form string="Lead Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Customer Care"/>
                        </h1>
                    </div>                   
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_lead_category_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.category.view.tree</field>
        <field name="model">crm.lead.category</field>
        <field name="arch" type="xml">
            <tree string="Lead Category" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Tags Configuration -->
    <record id="crm_lead_category_action" model="ir.actions.act_window">
        <field name="name">Lead Category</field>
        <field name="res_model">crm.lead.category</field>
        <field name="view_id" ref="crm_lead_category_view_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create CRM Lead Category
            </p><p>
            Use Lead Category to manage and track your Lead (product structure, sales type, ...)
            </p>
        </field>
    </record>

    <menuitem id="menu_crm_lead_category" name="Lead Category" action="crm_lead_category_action" parent="crm.menu_crm_config_lead" sequence="5"/>
    
    
</odoo>
