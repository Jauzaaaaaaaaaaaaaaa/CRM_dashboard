<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create global mail.activity.type for fallback (optional) -->
    <record id="mail_activity_type_timestep_followup" model="mail.activity.type">
        <field name="name">Timestep Followup</field>
        <field name="summary">Timestep follow-up reminder</field>
    </record>

    <!-- Cron job (run daily) -->
    <record id="cron_crm_timestep_daily" model="ir.cron">
        <field name="name">CRM Lead Timestep Processor (daily)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_timestep_leads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
