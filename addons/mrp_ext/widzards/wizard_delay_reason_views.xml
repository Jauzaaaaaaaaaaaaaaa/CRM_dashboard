<odoo>  

    <!-- Delay Reason Wizard View -->
    <record id="view_mrp_production_delay_wizard" model="ir.ui.view">
        <field name="name">mrp.production.delay.wizard.form</field>
        <field name="model">mrp.production.delay.wizard</field>
        <field name="arch" type="xml">
            <form string="Delay Reason">
                <group>
                    <field name="production_id" readonly="1" />
                    <field name="delay_reason" required="1" />
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm_delay" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_mrp_production_delay_wizard" model="ir.actions.act_window">
        <field name="name">Delay Reason</field>
        <field name="res_model">mrp.production.delay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
