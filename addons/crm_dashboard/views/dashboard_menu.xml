<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action untuk membuka Dashboard -->
    <record id="crm_ext_action_dashboard" model="ir.actions.client">
        <field name="name">CRM Dashboard</field>
        <field name="tag">crm_dashboard</field>
    </record>

    <!-- Tambah menu Dashboard di bawah CRM -->
    <menuitem 
        id="crm_ext_menu_dashboard"
        name="Dashboard"
        parent="crm.crm_menu_root"
        action="crm_ext_action_dashboard"
        sequence="2"/>
</odoo>
