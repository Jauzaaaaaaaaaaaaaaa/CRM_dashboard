<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <!-- This is a comment describing the CRM Dashboard section -->
    <t t-name="CRMdashboard">
        <div class="o_content">
            <div class="o_view_controller">
                <div class="oh_dashboards"
                    style="margin-top: 0px; overflow-y: auto; vertical-align: middle; overflow-x: hidden;">
                    <div class="container-fluid my-5 o_hr_dashboard">
                        <t t-call="LoginUser"/>
                        <t t-call="Managercrm"/>
                        <t t-call="Admincrm"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
    <!-- This is a comment describing the LoginUser section -->
    <t t-name="LoginUser">
        <section class="dashboard_main_section" id="main_section_login">
            <div class="row">
                <div class="col-sm-12 mb-4">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-8">
                            <h2 class="section-header">CRM Dashboard
                            </h2>
                        </div>
                        <div class="col-12 col-sm-12 col-md-4">
                            <form class="form-group">
                                <select id="income_expense_values"
                                        t-on-change="(e) => this.on_change_income_expense_values(e)"
                                        class="form-control">
                                    <option id="this_year"
                                            value="this_year">This Year
                                    </option>
                                    <option id="this_quarter"
                                            value="this_quarter">This
                                        Quarter
                                    </option>
                                    <option id="this_month"
                                            value="this_month"
                                            selected="">This Month
                                    </option>
                                    <option id="this_week"
                                            value="this_week">This Week
                                    </option>
                                </select>
                            </form>
                        </div>
                    </div>
                    <hr/>
                </div>
            </div>
        </section>
    </t>
    <!-- Manager CRM Section -->
    <t t-name="Managercrm">
        <section class="dashboard_main_section" id="main_section_manager">
            <div class="crm_dash_cards row">
                <!-- 1. Team Opportunities -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow opportunity" t-on-click="(e) => this.opportunity(e)">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-trophy text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="opp_this_year"></div>
                                    <div id="opp_this_quarter"></div>
                                    <div id="opp_this_month"></div>
                                    <div id="opp_this_week"></div>
                                </span>
                            </h3>
                            <h4>Team Opportunities</h4>
                        </div>
                    </div>
                </div>

                <!-- 2. Win Ratio -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow opportunity_ratio">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-percent text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="total_revenue_this_year"></div>
                                    <div id="total_revenue_this_quarter"></div>
                                    <div id="total_revenue_this_month"></div>
                                    <div id="total_revenue_this_week"></div>
                                </span>
                            </h3>
                            <h4>Win Ratio</h4>
                        </div>
                    </div>
                </div>

                <!-- 3. Lost Ratio -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow lost_ratio">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-percent text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="ratio_this_year"></div>
                                    <div id="ratio_this_quarter"></div>
                                    <div id="ratio_this_month"></div>
                                    <div id="ratio_this_week"></div>
                                </span>
                            </h3>
                            <h4>Lost Ratio</h4>
                        </div>
                    </div>
                </div>

                <!-- 4. Total Revenue -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow revenue_card w-100" t-on-click="(e) => this.revenue_card(e)">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-usd text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="rev_this_year"></div>
                                    <div id="rev_this_quarter"></div>
                                    <div id="rev_this_month"></div>
                                    <div id="rev_this_week"></div>
                                </span>
                            </h3>
                            <h4>Total Revenue</h4>
                        </div>
                    </div>
                </div>

                <!-- 5. Team Leads -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow my_lead" t-on-click="(e) => this.my_lead(e)">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-line-chart text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="leads_this_year"></div>
                                    <div id="leads_this_quarter"></div>
                                    <div id="leads_this_month"></div>
                                    <div id="leads_this_week"></div>
                                </span>
                            </h3>
                            <h4>Team Leads</h4>
                        </div>
                    </div>
                </div>

                <!-- 6. Active Leads -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow active_leads_card">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-bolt text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span id="active_leads">0</span>
                            </h3>
                            <h4>Active Leads</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== ROW 2 ===== -->
            <div class="row mt-3">

                <!-- 7. Follow Up Do -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow custom_kpi_followup">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-tasks text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span id="custom_kpi_followup"></span>
                                <span id="followup_this_year" style="display:none;"></span>
                                <span id="followup_this_quarter" style="display:none;"></span>
                                <span id="followup_this_month" style="display:none;"></span>
                                <span id="followup_this_week" style="display:none;"></span>
                            </h3>
                            <h4>Follow Up Do</h4>
                        </div>
                    </div>
                </div>


                <!-- 8. Average Closing Time -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow avg_close_time">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-clock-o text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <div id="avg_time_this_year"></div>
                                    <div id="avg_time_this_quarter"></div>
                                    <div id="avg_time_this_month"></div>
                                    <div id="avg_time_this_week"></div>
                                </span>
                            </h3>
                            <h4>Average Closing Time</h4>
                        </div>
                    </div>
                </div>

                <!-- 9. Emails Sent -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow custom_kpi_email">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-envelope text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3><span id="custom_kpi_email"></span></h3>
                            <h4>Emails Sent</h4>
                        </div>
                    </div>
                </div>

                <!-- 10. Teams Meeting -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow custom_kpi_meeting">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-users text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3><span id="custom_kpi_meeting"></span></h3>
                            <h4>Teams Meeting</h4>
                        </div>
                    </div>
                </div>

                <!-- 11. Teams Calls -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow custom_kpi_calls">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-phone text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3><span id="custom_kpi_calls"></span></h3>
                            <h4>Teams Calls</h4>
                        </div>
                    </div>
                </div>

                <!-- 12. Top Sales Person -->
                <div class="col-sm-6 col-md-2">
                    <div class="dashboard-card card-shadow custom_kpi_top_sales">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-user-tie text-mauve"></i>
                        </div>
                        <div class="dashboard-card__details">
                            <h3><span id="custom_kpi_top_sales"></span></h3>
                            <h4>Top Sales Person</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-5">
                <!-- Kiri Atas: Opportunities by Stage -->
                <div class="col-sm-12 col-md-6">
                
                    <div class="bar_chart_div half_chart chart-container card-shadow" style="height:440px;">
                        <h2>Opportunities by Stage</h2>
                        <hr/>
                        <div class="graph_canvas" style="height:370px;">
                            <div id="container" style="height:100%; width:100%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Kanan Atas: Priority Distribution -->
                <div class="col-sm-12 col-md-6">
                    <div class="priority_pie_div half_chart chart-container card-shadow" style="height:440px;">
                        <h2>Priority Distribution</h2>
                        <hr/>
                        <div class="graph_canvas d-flex justify-content-center align-items-center" style="height:370px;">
                            <canvas id="priority_pie"
                                style="
                                    width: 100% !important;
                                    height: 100% !important;
                                    max-width: 310px;
                                    max-height: 310px;
                                    aspect-ratio: 1 / 1;
                                    transform: scale(1.05);
                                ">
                            </canvas>
                        </div>
                    </div>
                </div>

                <!-- Kiri Bawah: Custom Card -->
                <div class="col-sm-12 col-md-6 mt-4">
                    <div class="chart-container card-shadow half_chart p-4" style="height:440px;">
                        <h2>Custom Card</h2>
                        <hr/>
                        <div class="graph_canvas d-flex justify-content-center align-items-center" style="height:370px;">
                            <p style="font-size:16px; color:#555; text-align:center; opacity:0.7;">
                                Tambahkan informasi tambahan atau insight di sini.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Kanan Bawah: Won vs Lost -->
                <div class="col-sm-12 col-md-6 mt-4">
                    <div class="won_lost_pie_div half_chart chart-container card-shadow" style="height:440px;">
                        <h2>Won vs Lost</h2>
                        <hr/>
                        <div class="graph_canvas d-flex justify-content-center align-items-center" style="height:370px;">
                            <div id="won_lost_pie" style="height:100%; width:100%;"></div>
                        </div>
                    </div>
                </div>
